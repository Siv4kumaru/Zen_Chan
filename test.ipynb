{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Zen Chan Graph Ideas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import sqlite3\n",
    "import plotly.express as px\n",
    "import plotly.graph_objects as go"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Visit Duration vs. Time of Day (Violin Plot)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "conn = sqlite3.connect('data.db')\n",
    "df = pd.read_sql_query('SELECT time_of_day, visit_duration_sec FROM visits', conn)\n",
    "conn.close()\n",
    "\n",
    "fig = px.violin(df, x='time_of_day', y='visit_duration_sec', box=True, points='all', \n",
    "                title='Visit Duration vs. Time of Day', \n",
    "                labels={'time_of_day': 'Time of Day', 'visit_duration_sec': 'Visit Duration (seconds)'})\n",
    "fig.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Pre-label Co-occurrence (Heatmap)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "conn = sqlite3.connect('data.db')\n",
    "df = pd.read_sql_query('SELECT visit_id, pre_labels FROM visits', conn)\n",
    "conn.close()\n",
    "\n",
    "# Create a co-occurrence matrix\n",
    "co_occurrence = pd.crosstab(df['visit_id'], df['pre_labels'])\n",
    "co_occurrence = co_occurrence.T.dot(co_occurrence)\n",
    "fig = px.imshow(co_occurrence, title='Pre-label Co-occurrence')\n",
    "fig.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Domain Diversity Over Time (Line Chart)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "conn = sqlite3.connect('data.db')\n",
    "df = pd.read_sql_query('SELECT visit_datetime, domain FROM visits', conn)\n",
    "conn.close()\n",
    "\n",
    "df['visit_date'] = pd.to_datetime(df['visit_datetime']).dt.date\n",
    "domain_diversity = df.groupby('visit_date')['domain'].nunique().reset_index()\n",
    "\n",
    "fig = px.line(domain_diversity, x='visit_date', y='domain', title='Domain Diversity Over Time',
",
    "              labels={'visit_date': 'Date', 'domain': 'Number of Unique Domains'})
",
    "fig.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Mood Transitions (Sankey Diagram)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "conn = sqlite3.connect('data.db')\n",
    "df = pd.read_sql_query('SELECT visit_datetime, mood FROM visits ORDER BY visit_datetime', conn)\n",
    "mood_colors_df = pd.read_sql_query('SELECT mood, color_hex FROM moods', conn)\n",
    "conn.close()\n",
    "\n",
    "mood_colors = mood_colors_df.set_index('mood')['color_hex'].to_dict()\n",
    "\n",
    "df['mood_from'] = df['mood']\n",
    "df['mood_to'] = df['mood'].shift(-1)\n",
    "mood_transitions = df.groupby(['mood_from', 'mood_to']).size().reset_index(name='value')\n",
    "\n",
    "# Thresholding\n",
    "threshold = 5\n",
    "mood_transitions = mood_transitions[mood_transitions['value'] >= threshold]\n",
    "\n",
    "# Two-column layout\n",
    "all_moods_from = list(pd.unique(mood_transitions['mood_from']))\n",
    "all_moods_to = list(pd.unique(mood_transitions['mood_to']))\n",
    "\n",
    "all_moods = all_moods_from + all_moods_to\n",
    "mood_map = {mood: i for i, mood in enumerate(all_moods)}\n",
    "\n",
    "fig = go.Figure(data=[go.Sankey(\n",
    "    node = dict(\n",
    "      pad = 15,\n",
    "      thickness = 20,\n",
    "      line = dict(color = 'black', width = 0.5),\n",
    "      label = [mood + ' (from)' for mood in all_moods_from] + [mood + ' (to)' for mood in all_moods_to],\n",
    "      color = [mood_colors.get(mood, 'blue') for mood in all_moods_from] + [mood_colors.get(mood, 'blue') for mood in all_moods_to]\n",
    "    ),\n",
    "    link = dict(\n",
    "      source = mood_transitions['mood_from'].map(mood_map),\n",
    "      target = mood_transitions['mood_to'].map(lambda x: mood_map.get(x) + len(all_moods_from) if pd.notna(x) else -1),\n",
    "      value = mood_transitions['value']\n",
    "  ))])\n",
    "\n",
    "fig.update_layout(title_text='Mood Transitions (Threshold = 5)', font_size=10)\n",
    "fig.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Mood Transition Probability (Heatmap)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "conn = sqlite3.connect('data.db')\n",
    "df = pd.read_sql_query('SELECT visit_datetime, mood FROM visits ORDER BY visit_datetime', conn)\n",
    "conn.close()\n",
    "\n",
    "df['mood_from'] = df['mood']\n",
    "df['mood_to'] = df['mood'].shift(-1)\n",
    "transition_matrix = pd.crosstab(df['mood_from'], df['mood_to'], normalize='index')\n",
    "\n",
    "fig = px.imshow(transition_matrix, text_auto=True, title='Mood Transition Probability')\n",
    "fig.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Total Browsing Time by Day/Month/Year (Bar Chart)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "conn = sqlite3.connect('data.db')\n",
    "df = pd.read_sql_query('SELECT visit_datetime, visit_duration_sec FROM visits', conn)\n",
    "conn.close()\n",
    "\n",
    "df['visit_datetime'] = pd.to_datetime(df['visit_datetime'])\n",
    "\n",
    "# Daily\n",
    "daily_browsing = df.groupby(df['visit_datetime'].dt.date)['visit_duration_sec'].sum().reset_index()\n",
    "fig_daily = px.bar(daily_browsing, x='visit_datetime', y='visit_duration_sec', title='Total Browsing Time by Day')\n",
    "fig_daily.show()\n",
    "\n",
    "# Monthly\n",
    "monthly_browsing = df.groupby(df['visit_datetime'].dt.to_period('M'))['visit_duration_sec'].sum().reset_index()\n",
    "monthly_browsing['visit_datetime'] = monthly_browsing['visit_datetime'].astype(str)\n",
    "fig_monthly = px.bar(monthly_browsing, x='visit_datetime', y='visit_duration_sec', title='Total Browsing Time by Month')\n",
    "fig_monthly.show()\n",
    "\n",
    "# Yearly\n",
    "yearly_browsing = df.groupby(df['visit_datetime'].dt.year)['visit_duration_sec'].sum().reset_index()\n",
    "fig_yearly = px.bar(yearly_browsing, x='visit_datetime', y='visit_duration_sec', title='Total Browsing Time by Year')\n",
    "fig_yearly.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Top Moods/Activities for a Given Period (Bar Chart)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "conn = sqlite3.connect('data.db')\n",
    "df = pd.read_sql_query('SELECT visit_datetime, mood, pre_labels, visit_duration_sec FROM visits', conn)\n",
    "conn.close()\n",
    "\n",
    "df['visit_datetime'] = pd.to_datetime(df['visit_datetime'])\n",
    "\n",
    "def get_top_data(dataframe, column, time_filter=None):\n",
    "    filtered_df = dataframe.copy()\n",
    "    if time_filter == 'today':\n",
    "        filtered_df = filtered_df[filtered_df['visit_datetime'].dt.date == pd.to_datetime('today').date()]\n",
    "    elif time_filter == 'this_month':\n",
    "        filtered_df = filtered_df[filtered_df['visit_datetime'].dt.to_period('M') == pd.to_datetime('today').to_period('M')]\n",
    "    elif time_filter == 'this_year':\n",
    "        filtered_df = filtered_df[filtered_df['visit_datetime'].dt.year == pd.to_datetime('today').year]\n",
    "    \n",
    "    if not filtered_df.empty:\n",
    "        top_data = filtered_df.groupby(column)['visit_duration_sec'].sum().nlargest(5).reset_index()\n",
    "        return top_data\n",
    "    return pd.DataFrame(columns=[column, 'visit_duration_sec'])\n",
    "\n",
    "time_periods = [None, 'today', 'this_month', 'this_year']\n",
    "columns_to_analyze = ['mood', 'pre_labels']\n",
    "\n",
    "for period in time_periods:\n",
    "    for col in columns_to_analyze:\n",
    "        top_data = get_top_data(df, col, period)\n",
    "        if not top_data.empty:\n",
    "            title_suffix = f' for {period.replace('_', ' ').title()}' if period else ' (All Time)'\n",
    "            fig = px.bar(top_data, x='visit_duration_sec', y=col, orientation='h',
",
    "                         title=f'Top 5 {col.replace('_', ' ').title()}{title_suffix}',
",
    "                         labels={'visit_duration_sec': 'Total Duration (seconds)', col: col.replace('_', ' ').title()})
",
    "            fig.show()\n",
    "        else:\n",
    "            print(f"No data for Top 5 {col.replace('_', ' ').title()}{' for ' + period.replace('_', ' ').title() if period else ' (All Time)'}")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Average Visit Duration by Domain (Bar Chart)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "conn = sqlite3.connect('data.db')\n",
    "df = pd.read_sql_query('SELECT domain, visit_duration_sec FROM visits', conn)\n",
    "conn.close()\n",
    "\n",
    "avg_duration_by_domain = df.groupby('domain')['visit_duration_sec'].mean().reset_index()\n",
    "avg_duration_by_domain = avg_duration_by_domain.sort_values(by='visit_duration_sec', ascending=False).head(10)\n",
    "\n",
    "fig = px.bar(avg_duration_by_domain, x='domain', y='visit_duration_sec',
",
    "             title='Average Visit Duration by Domain (Top 10)',
",
    "             labels={'domain': 'Domain', 'visit_duration_sec': 'Average Visit Duration (seconds)'})
",
    "fig.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. New Domains Discovered Over Time (Line Chart)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "conn = sqlite3.connect('data.db')\n",
    "df = pd.read_sql_query('SELECT visit_datetime, domain FROM visits', conn)\n",
    "conn.close()\n",
    "\n",
    "df['visit_datetime'] = pd.to_datetime(df['visit_datetime'])\n",
    "df = df.sort_values('visit_datetime')\n",
    "\n",
    "unique_domains = set()\n",
    "new_domains_over_time = []\n",
    "\n",
    "for index, row in df.iterrows():\n",
    "    if row['domain'] not in unique_domains:\n",
    "        unique_domains.add(row['domain'])\n",
    "    new_domains_over_time.append({'date': row['visit_datetime'], 'new_unique_domains': len(unique_domains)})
",
    "\n",
    "new_domains_df = pd.DataFrame(new_domains_over_time)\n",
    "new_domains_df = new_domains_df.groupby(new_domains_df['date'].dt.date)['new_unique_domains'].max().reset_index()\n",
    "\n",
    "fig = px.line(new_domains_df, x='date', y='new_unique_domains',
",
    "             title='Cumulative New Domains Discovered Over Time',
",
    "             labels={'date': 'Date', 'new_unique_domains': 'Cumulative New Unique Domains'})
",
    "fig.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Mood/Activity Distribution by Time of Day (Stacked Bar Chart)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "conn = sqlite3.connect('data.db')\n",
    "df = pd.read_sql_query('SELECT time_of_day, mood, pre_labels, visit_duration_sec FROM visits', conn)\n",
    "conn.close()\n",
    "\n",
    "order_of_day = ['deep night', 'early morning', 'morning', 'afternoon', 'evening', 'late night']\n",
    "\n",
    "# Mood Distribution\n",
    "mood_distribution = df.groupby(['time_of_day', 'mood'])['visit_duration_sec'].sum().reset_index()\n",
    "mood_distribution['time_of_day'] = pd.Categorical(mood_distribution['time_of_day'], categories=order_of_day, ordered=True)\n",
    "mood_distribution = mood_distribution.sort_values('time_of_day')\n",
    "\n",
    "fig_mood = px.bar(mood_distribution, x='time_of_day', y='visit_duration_sec', color='mood',
",
    "                  title='Mood Distribution by Time of Day',
",
    "                  labels={'time_of_day': 'Time of Day', 'visit_duration_sec': 'Total Duration (seconds)'})
",
    "fig_mood.show()\n",
    "\n",
    "# Activity Distribution\n",
    "activity_distribution = df.groupby(['time_of_day', 'pre_labels'])['visit_duration_sec'].sum().reset_index()\n",
    "activity_distribution['time_of_day'] = pd.Categorical(activity_distribution['time_of_day'], categories=order_of_day, ordered=True)\n",
    "activity_distribution = activity_distribution.sort_values('time_of_day')\n",
    "\n",
    "fig_activity = px.bar(activity_distribution, x='time_of_day', y='visit_duration_sec', color='pre_labels',
",
    "                      title='Activity Distribution by Time of Day',
",
    "                      labels={'time_of_day': 'Time of Day', 'visit_duration_sec': 'Total Duration (seconds)'})
",
    "fig_activity.show()"
   ]
  }
 ],
